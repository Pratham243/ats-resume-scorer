# ── LLM Configuration ──
# Set to 'false' to use Groq Cloud API (Llama 3), or 'true' to use local Ollama instance (GDPR compliant)
USE_LOCAL_LLM=false

# Groq Cloud API configuration (used when USE_LOCAL_LLM=false)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama local configuration (used when USE_LOCAL_LLM=true)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Supabase Authentication & Database ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# ── NLP & Machine Learning Models ──
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
SPACY_MODEL=en_core_web_md

# ── App Settings ──
BACKEND_PORT=8000
FRONTEND_PORT=8501
ALLOW_GUEST_ACCESS=true
